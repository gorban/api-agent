{
  "services": {
    "langfuse-web": {
      "image": "docker.io/langfuse/langfuse:3.163.0",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "clickhouse": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:3000:3000"
      ],
      "environment": {
        "NEXTAUTH_URL": "http://localhost:3000",
        "DATABASE_URL": "postgresql://postgres:${SA_POSTGRES_PASSWORD:?controlled local development value required}@postgres:5432/postgres",
        "SALT": "${SA_SALT:?controlled local development value required}",
        "ENCRYPTION_KEY": "${SA_ENCRYPTION_KEY:?controlled local development value required}",
        "TELEMETRY_ENABLED": "false",
        "CLICKHOUSE_MIGRATION_URL": "clickhouse://clickhouse:9000",
        "CLICKHOUSE_URL": "http://clickhouse:8123",
        "CLICKHOUSE_USER": "clickhouse",
        "CLICKHOUSE_PASSWORD": "${SA_CLICKHOUSE_PASSWORD:?controlled local development value required}",
        "CLICKHOUSE_CLUSTER_ENABLED": "false",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "REDIS_AUTH": "${SA_REDIS_PASSWORD:?controlled local development value required}",
        "REDIS_TLS_ENABLED": "false",
        "LANGFUSE_S3_BATCH_EXPORT_BUCKET": "langfuse",
        "LANGFUSE_S3_BATCH_EXPORT_REGION": "us-east-1",
        "LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_BATCH_EXPORT_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_BATCH_EXPORT_PREFIX": "exports/",
        "LANGFUSE_S3_BATCH_EXPORT_ENABLED": "false",
        "NEXTAUTH_SECRET": "${SA_NEXTAUTH_SECRET:?controlled local development value required}",
        "LANGFUSE_INIT_ORG_ID": "local-${SA_SCOPE:?controlled local development value required}",
        "LANGFUSE_INIT_ORG_NAME": "API Agent local development",
        "LANGFUSE_INIT_PROJECT_ID": "api-agent-${SA_SCOPE:?controlled local development value required}",
        "LANGFUSE_INIT_PROJECT_NAME": "API Agent local development",
        "LANGFUSE_INIT_PROJECT_PUBLIC_KEY": "${SA_LANGFUSE_PUBLIC_KEY:?controlled local development value required}",
        "LANGFUSE_INIT_PROJECT_SECRET_KEY": "${SA_LANGFUSE_SECRET_KEY:?controlled local development value required}",
        "LANGFUSE_INIT_USER_EMAIL": "admin@api-agent.invalid",
        "LANGFUSE_INIT_USER_NAME": "Local development",
        "LANGFUSE_INIT_USER_PASSWORD": "${SA_USER_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_EVENT_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_REGION": "us-east-1",
        "LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_EVENT_UPLOAD_PREFIX": "events/",
        "LANGFUSE_S3_MEDIA_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_REGION": "us-east-1",
        "LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_MEDIA_UPLOAD_PREFIX": "media/",
        "LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT": "http://localhost:9090"
      }
    },
    "langfuse-worker": {
      "image": "docker.io/langfuse/langfuse-worker:3.163.0",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "clickhouse": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "NEXTAUTH_URL": "http://localhost:3000",
        "DATABASE_URL": "postgresql://postgres:${SA_POSTGRES_PASSWORD:?controlled local development value required}@postgres:5432/postgres",
        "SALT": "${SA_SALT:?controlled local development value required}",
        "ENCRYPTION_KEY": "${SA_ENCRYPTION_KEY:?controlled local development value required}",
        "TELEMETRY_ENABLED": "false",
        "CLICKHOUSE_MIGRATION_URL": "clickhouse://clickhouse:9000",
        "CLICKHOUSE_URL": "http://clickhouse:8123",
        "CLICKHOUSE_USER": "clickhouse",
        "CLICKHOUSE_PASSWORD": "${SA_CLICKHOUSE_PASSWORD:?controlled local development value required}",
        "CLICKHOUSE_CLUSTER_ENABLED": "false",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "REDIS_AUTH": "${SA_REDIS_PASSWORD:?controlled local development value required}",
        "REDIS_TLS_ENABLED": "false",
        "LANGFUSE_S3_BATCH_EXPORT_BUCKET": "langfuse",
        "LANGFUSE_S3_BATCH_EXPORT_REGION": "us-east-1",
        "LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_BATCH_EXPORT_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_BATCH_EXPORT_PREFIX": "exports/",
        "LANGFUSE_S3_BATCH_EXPORT_ENABLED": "false",
        "LANGFUSE_S3_EVENT_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_REGION": "us-east-1",
        "LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_EVENT_UPLOAD_PREFIX": "events/",
        "LANGFUSE_S3_MEDIA_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_REGION": "us-east-1",
        "LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID": "localdev",
        "LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY": "${SA_MINIO_PASSWORD:?controlled local development value required}",
        "LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_MEDIA_UPLOAD_PREFIX": "media/"
      }
    },
    "postgres": {
      "image": "docker.io/library/postgres:17.6",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "postgres",
        "POSTGRES_PASSWORD": "${SA_POSTGRES_PASSWORD:?controlled local development value required}"
      },
      "volumes": [
        "langfuse-postgres:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "clickhouse": {
      "image": "docker.io/clickhouse/clickhouse-server:25.3.6.56",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "user": "101:101",
      "environment": {
        "CLICKHOUSE_USER": "clickhouse",
        "CLICKHOUSE_PASSWORD": "${SA_CLICKHOUSE_PASSWORD:?controlled local development value required}",
        "CLICKHOUSE_DB": "default"
      },
      "volumes": [
        "langfuse-clickhouse:/var/lib/clickhouse",
        "langfuse-clickhouse-logs:/var/log/clickhouse-server"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--no-verbose",
          "--tries=1",
          "--spider",
          "http://localhost:8123/ping"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "redis": {
      "image": "docker.io/library/redis:7.4.5",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "command": [
        "redis-server",
        "--requirepass",
        "${SA_REDIS_PASSWORD:?controlled local development value required}",
        "--maxmemory-policy",
        "noeviction"
      ],
      "environment": {
        "REDISCLI_AUTH": "${SA_REDIS_PASSWORD:?controlled local development value required}"
      },
      "volumes": [
        "langfuse-redis:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "minio": {
      "image": "cgr.dev/chainguard/minio:latest@sha256:90a55c0e00a6a5e932c2ffd1d357e5fa5bd33495abd3aac45f0a83b6be80dae5",
      "profiles": [
        "langfuse"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      },
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "mkdir -p /data/langfuse && minio server --address :9000 --console-address :9001 /data"
      ],
      "environment": {
        "MINIO_ROOT_USER": "localdev",
        "MINIO_ROOT_PASSWORD": "${SA_MINIO_PASSWORD:?controlled local development value required}"
      },
      "ports": [
        "127.0.0.1:9090:9000",
        "127.0.0.1:9091:9001"
      ],
      "volumes": [
        "langfuse-minio:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mc",
          "ready",
          "local"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "10s"
      }
    },
    "jaeger": {
      "image": "cr.jaegertracing.io/jaegertracing/jaeger:2.21.0",
      "profiles": [
        "otel"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "otel"
      },
      "ports": [
        "127.0.0.1:4318:4318",
        "127.0.0.1:${SA_JAEGER_VIEWER_PORT:?controlled local development value required}:16686"
      ],
      "command": ["--config", "/etc/jaeger/config.json"],
      "volumes": [
        "jaeger-badger:/tmp",
        "${SA_JAEGER_CONFIG:?controlled local development value required}:/etc/jaeger/config.json:ro,z"
      ]
    },
    "localstack": {
      "image": "docker.io/gresau/localstack-persist:4.14.0@sha256:57a8a80a3bfc0c498858df261ef9d39ba129a191d034a8a5d47c5db9a656611f",
      "profiles": [
        "localstack"
      ],
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "localstack"
      },
      "environment": {
        "SERVICES": "s3",
        "PERSIST_DEFAULT": "0",
        "PERSIST_S3": "1",
        "PERSIST_FREQUENCY": "1",
        "AWS_DEFAULT_REGION": "${SA_ALLURE_S3_REGION:?controlled local development value required}",
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "SA_ALLURE_S3_BUCKET": "${SA_ALLURE_S3_BUCKET:?controlled local development value required}",
        "SA_ALLURE_S3_REGION": "${SA_ALLURE_S3_REGION:?controlled local development value required}",
        "SA_LOCALSTACK_READY_DIGEST": "${SA_LOCALSTACK_READY_DIGEST:?controlled local development value required}"
      },
      "ports": [
        "127.0.0.1:${SA_LOCALSTACK_PORT:?controlled local development value required}:4566"
      ],
      "volumes": [
        "localstack-data:/persisted-data",
        "${SA_LOCALSTACK_READY_HOOK:?controlled local development value required}:/etc/localstack/init/ready.d/10-api-agent-s3.sh:ro,z"
      ]
    }
  },
  "volumes": {
    "jaeger-badger": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "otel"
      }
    },
    "langfuse-postgres": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      }
    },
    "langfuse-clickhouse": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      }
    },
    "langfuse-clickhouse-logs": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      }
    },
    "langfuse-redis": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      }
    },
    "langfuse-minio": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "langfuse"
      }
    },
    "localstack-data": {
      "labels": {
        "api-agent.managed": "true",
        "api-agent.scope": "${SA_SCOPE:?controlled local development value required}",
        "api-agent.profile": "localstack"
      }
    }
  }
}
